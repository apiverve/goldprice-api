            "email": "hello@apiverve.com",
            "homepage": "https://apiverve.com"
        }
    ],
    "keywords": [
        "api",
        "apiverve",
        "goldprice",
        "gold price api",
        "gold rate api",
        "gold api",
        "gold price per gram api",
        "gold price in eur"
    ],
    "homepage": "https://apiverve.com/marketplace/goldprice?utm_source=php&utm_medium=referral&utm_content=homepage",
    "support": {
        "email": "hello@apiverve.com",
        "docs": "https://docs.apiverve.com/ref/goldprice",
        "source": "https://github.com/apiverve/goldprice-API/tree/main/php"
    },
    "require": {
        "php": ">=7.4",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0"
    },
    "autoload": {
        "psr-4": {
            "APIVerve\\Goldprice\\": "php/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
